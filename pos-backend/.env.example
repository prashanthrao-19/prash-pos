# ===================================================
# PNS POS BACKEND ENVIRONMENT VARIABLES (EXAMPLE / TEMPLATE)
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER COMMIT .env OR REAL CREDENTIALS TO SOURCE CONTROL.
# ===================================================

# ----------------- SPRING PROFILE -----------------
# Options: dev | prod
SPRING_PROFILES_ACTIVE=dev

# ----------------- SERVER CONFIG ------------------
# The port the backend listens on (Render / Cloud platforms set this automatically)
PORT=5000

# ----------------- DATABASE CONFIG ----------------
# Standard connection parameters (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nehapos
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# Optional: Full JDBC Connection URL (takes precedence if provided)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/nehapos?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ----------------- JWT SECURITY -------------------
# Must be a cryptographically secure key of at least 256 bits (32 bytes)
APP_JWT_SECRET=your_minimum_256_bit_jwt_secret_key_placeholder_here

# ----------------- FRONTEND & CORS CONFIG ---------
# Deployed frontend URL for callbacks & reset links
FRONTEND_URL=http://localhost:5173
FRONTEND_RESET_URL=http://localhost:5173/auth/reset-password?token=

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------------- PAYMENT GATEWAYS ---------------
# Razorpay API Credentials & Webhook Secret
RAZORPAY_API_KEY=rzp_test_your_razorpay_key_id
RAZORPAY_API_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Stripe API Credentials & Webhook Secret
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ----------------- AI / GEMINI API ----------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# ----------------- MAIL / SMTP CONFIG -------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@domain.com
MAIL_PASSWORD=your_app_specific_email_password
